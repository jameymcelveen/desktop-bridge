{
  "name": "desktop-bridge",
  "version": "1.0.0",
  "description": "Local Mac MCP server that lets Claude read/write files, inspect the system, run shell commands, use the clipboard, and capture the screen.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "desktop-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/lib/*.test.js",
    "inspector": "npm run build && npx --yes @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "macos",
    "desktop"
  ],
  "author": "Jamey McElveen",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
