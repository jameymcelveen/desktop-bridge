# Comma-separated directories the file tools (and optional shell cwd) may access.
# Unset = ~/Desktop, ~/Documents, ~/Downloads, and the OS temp dir (if they exist).
# DESKTOP_BRIDGE_ROOTS=/Users/you/Desktop,/Users/you/Documents,/Users/you/Downloads

# Max bytes for a single file read/write (default 10485760 = 10 MiB).
# DESKTOP_BRIDGE_MAX_FILE_BYTES=10485760

# Default shell timeout in milliseconds (default 30000, max 300000).
# DESKTOP_BRIDGE_COMMAND_TIMEOUT_MS=30000

# Combined stdout+stderr capture cap (default 1048576 = 1 MiB).
# DESKTOP_BRIDGE_MAX_OUTPUT_BYTES=1048576

# Set to 0/false/no to disable run_command.
# DESKTOP_BRIDGE_ALLOW_SHELL=true

# Set to 0/false/no to let run_command use a cwd outside allowed roots.
# DESKTOP_BRIDGE_RESTRICT_SHELL_CWD=true

# Optional: POST a heartbeat to the status site so the dashboard shows this Mac as online.
# DESKTOP_BRIDGE_STATUS_URL=https://YOUR-RAILWAY-HOST/api/heartbeat
# DESKTOP_BRIDGE_STATUS_TOKEN=
# DESKTOP_BRIDGE_STATUS_INTERVAL_MS=15000
